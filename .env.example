# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Maximum number of projection displays allowed in one live room.
# Defaults to 20 when omitted or invalid.
MAX_DISPLAYS_PER_ROOM="20"

# Comma-separated browser origins allowed to call the HTTP/WebSocket backend.
# Built-in defaults already include localhost and countdown-studio.id.vn.
CORS_ORIGINS="http://abc.vn,https://abc.vn"

# MariaDB connection used by the authentication/RBAC API.
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME="countdown_studio"
DB_USER="countdown_studio_user"
DB_PASSWORD="CHANGE_ME"

# Required for signing login sessions. Use a long random value in production.
AUTH_TOKEN_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
AUTH_TOKEN_TTL_SECONDS="604800"

# Optional: enables protected Admin registration. Organization accounts are
# provisioned by an Admin and cannot be self-registered.
ADMIN_REGISTRATION_CODE="CHANGE_ME_ADMIN_CODE"
