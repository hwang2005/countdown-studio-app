# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional separate backend origin for static frontend builds.
# Leave empty for the full-stack deployment (same-origin /api).
VITE_API_URL=""

# Optional separate WebSocket origin for static frontend builds.
# Leave empty for the full-stack deployment (same-origin /ws).
VITE_STAGE_WS_URL=""

# Optional extra WebSocket hostnames (comma-separated) trusted as backend
# endpoints in addition to the built-in allowlist (own domain, localhost,
# *.onrender.com). Example: "ws1.example.com,ws2.example.org"
VITE_TRUSTED_WS_HOSTS=""

# Maximum number of projection displays allowed in one live room.
# Defaults to 20 when omitted or invalid.
MAX_DISPLAYS_PER_ROOM="20"

# Comma-separated browser origins allowed to call the HTTP/WebSocket backend.
# Built-in defaults already include localhost and countdown-studio.id.vn.
CORS_ORIGINS="http://abc.vn,https://abc.vn"

# PostgreSQL/Supabase connection used by the authentication/RBAC API.
# Prefer the Supabase pooler connection string in production.
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"
# Optional local/fallback connection settings when DATABASE_URL is not set.
DB_HOST="127.0.0.1"
DB_PORT="5432"
DB_NAME="countdown_studio"
DB_USER="postgres"
DB_PASSWORD="CHANGE_ME"
DB_SSL="false"

# Required for signing login sessions. Use a long random value in production.
AUTH_TOKEN_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
AUTH_TOKEN_TTL_SECONDS="604800"

# Resend SMTP relay used for transactional email (Forgot credentials, OTP...).
# SMTP_USER is the literal string "resend"; the password is a Resend API key
# (re_...) created under Dashboard -> API Keys (exporting/sending permission).
# SMTP_FROM_EMAIL must be an address on the Resend-verified domain. Never commit the key.
SMTP_HOST="smtp.resend.com"
# Port 2465 = Resend's SSL alternate port. Render free-tier web services block
# outbound ports 25/465/587, so production must use 2465 (SSL) or 2587
# (STARTTLS). Choose 465 only where those ports are permitted.
SMTP_PORT="2465"
SMTP_SECURE="true"
SMTP_USER="resend"
SMTP_PASSWORD="r_MY_RESEND_SMTP_KEY"
SMTP_FROM_EMAIL="no-reply@countdown-studio.id.vn"
SMTP_SENDER_NAME="Countdown Studio Support"
# Optional recipient override for the standalone SMTP smoke test (npm run test:smtp).
SMTP_TEST_TO="MY_INBOX@example.invalid"

# Validity window of a password reset link, in minutes (default 30).
RESET_LINK_TTL_MINUTES="30"

# Optional: enables protected Admin registration. Organization accounts are
# provisioned by an Admin and cannot be self-registered.
ADMIN_REGISTRATION_CODE="CHANGE_ME_ADMIN_CODE"

# Google OAuth 2.0 Client ID (from Google Cloud Console > Credentials)
# When set, enables production Google Identity Services button & verification.
# When empty, Countdown Studio provides an interactive dev simulation mode.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional test-account bootstrap. Never commit the values below; provide them
# through deployment secrets before running `npm run seed:test-accounts`.
TEST_INDIVIDUAL_PASSWORD=""
TEST_INDIVIDUAL_EMAIL="test-individual@example.invalid"
TEST_ORGANIZATION_PASSWORD=""
TEST_ORGANIZATION_EMAIL="test-organization@example.invalid"
TEST_ADMIN_PASSWORD=""
TEST_ADMIN_EMAIL="test-admin@example.invalid"

# Persistent Versus room lifecycle.
ROOM_IDLE_TIMEOUT_MS="43200000"
ORPHANED_ROOM_TIMEOUT_MS="30000"

# Room PIN brute-force lockout (applies per room code across reconnects).
PIN_LOCK_MAX_ATTEMPTS="5"
PIN_LOCK_WINDOW_MS="900000"

# Content-Security-Policy mode. "report-only" (default) observes violations
# without blocking; "enforce" blocks after the console is clean; "off" disables.
CSP_MODE="report-only"
# Optional full policy override (add trusted WebSocket/display hosts here when
# deploying the frontend to origins other than *.onrender.com).
# CSP_POLICY="default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com; ..."
